ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:5173
AUTH_REQUIRED=true
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.json,.csv,.html,.htm
MAX_UPLOAD_BYTES=41943040
WEAK_EVIDENCE_SCORE_THRESHOLD=0.35

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
RAGAS_GEMINI_MODEL=gemini-3.1-flash-lite
RAGAS_MAX_CONTEXTS=1
RAGAS_MAX_CONTEXT_CHARS=700
RAGAS_METRICS=faithfulness
RAGAS_WORKER_TIMEOUT_SECONDS=180
RAGAS_LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_mind_chunks
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_UPSERT_WAIT=false

INGESTION_QUEUE_BACKEND=local
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=australia-southeast1
CLOUD_TASKS_QUEUE_ID=legalmind-ingestion
INGESTION_TASK_HANDLER_URL=
INGESTION_TASK_SECRET=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

EVALUATION_QUEUE_BACKEND=local_process
EVALUATION_CLOUD_TASKS_QUEUE_ID=legalmind-evaluation
EVALUATION_TASK_HANDLER_URL=
EVALUATION_TASK_SECRET=

FILE_STORAGE_BACKEND=local
INGESTION_UPLOAD_DIR=storage/uploads
GCS_BUCKET_NAME=
GCS_UPLOAD_PREFIX=uploads
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
#FIREBASE_PROJECT_ID=
